FROM debian:13

ENV container=container DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl dbus iproute2 iptables kmod openssh-server openssl \
      python3 sudo systemd systemd-sysv util-linux && \
    apt-get clean && rm -rf /var/lib/apt/lists/* && \
    systemctl set-default multi-user.target && \
    systemctl enable ssh.service && \
    systemctl mask dev-hugepages.mount sys-fs-fuse-connections.mount \
      systemd-update-utmp.service console-getty.service

RUN : > /etc/machine-id && : > /var/lib/dbus/machine-id

# Kubernetes workloads such as Cilium use mount propagation for bpffs and
# cgroup v2. Apple container machines are full Linux VMs, but their OCI-rootfs
# boot leaves the guest mount tree private, so make it recursively shared
# before k0s/containerd starts.
COPY erebor-mount-propagation.service /etc/systemd/system/erebor-mount-propagation.service
COPY erebor-ceph-loop /usr/local/sbin/erebor-ceph-loop
COPY erebor-ceph-loop.service /etc/systemd/system/erebor-ceph-loop.service
RUN chmod 0755 /usr/local/sbin/erebor-ceph-loop && \
    systemctl enable erebor-mount-propagation.service erebor-ceph-loop.service

# The private half remains in ~/.ssh on macOS. Ansible stages only the public
# half in the ignored build-context directory before building this image.
COPY ssh/id_apple_machine.pub /etc/ssh/apple_machine_authorized_keys
RUN chmod 0644 /etc/ssh/apple_machine_authorized_keys && \
    printf '%s\n' \
      'PubkeyAuthentication yes' \
      'PasswordAuthentication no' \
      'AuthorizedKeysFile /etc/ssh/apple_machine_authorized_keys' \
      > /etc/ssh/sshd_config.d/erebor.conf
