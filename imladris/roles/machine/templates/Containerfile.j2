FROM debian:13

ENV container=container DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl dbus iproute2 iptables kmod openssh-server \
      python3 sudo systemd systemd-sysv util-linux && \
    apt-get clean && rm -rf /var/lib/apt/lists/* && \
    systemctl set-default multi-user.target && \
    systemctl enable ssh.service && \
    systemctl mask dev-hugepages.mount sys-fs-fuse-connections.mount \
      systemd-update-utmp.service console-getty.service

RUN : > /etc/machine-id && : > /var/lib/dbus/machine-id

COPY authorized_keys /etc/ssh/imladris_authorized_keys
RUN chmod 0600 /etc/ssh/imladris_authorized_keys && \
    printf '%s\n' \
      'PubkeyAuthentication yes' \
      'PasswordAuthentication no' \
      'AuthorizedKeysFile /etc/ssh/imladris_authorized_keys' \
      > /etc/ssh/sshd_config.d/60-imladris-machine.conf

