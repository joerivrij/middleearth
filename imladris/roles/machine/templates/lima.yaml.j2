# Managed by Ansible (Imladris).
vmType: "{{ machine_lima_vm_type }}"
os: Linux

images:
  - location: "{{ machine_lima_image_arm64
      if ansible_facts.architecture == 'arm64'
      else machine_lima_image_x86_64 }}"
    arch: "{{ machine_architecture_map[ansible_facts.architecture] }}"

cpus: {{ machine_cpus }}
memory: "{{ machine_memory_gib }}GiB"
disk: "{{ machine_disk_gib }}GiB"

{% if machine_lima_additional_disks | length > 0 %}
additionalDisks:
{% for disk in machine_lima_additional_disks %}
  - name: "{{ disk.name }}"
    format: false
{% endfor %}
{% endif %}

networks:
{% if machine_lima_networks | length > 0 %}
{{ machine_lima_networks | to_nice_yaml(indent=2) | indent(2, true) }}
{% else %}
  - {{ machine_lima_network }}: true
{% endif %}

{% if machine_lima_kubernetes_api_host_port | int > 0
   or machine_lima_http_host_port | int > 0
   or machine_lima_https_host_port | int > 0 %}
portForwards:
{% if machine_lima_kubernetes_api_host_port | int > 0 %}
  - guestPort: 6443
    hostPort: {{ machine_lima_kubernetes_api_host_port }}
    proto: tcp
    static: true
{% endif %}
{% if machine_lima_http_host_port | int > 0 %}
  - guestPort: {{ machine_lima_http_guest_port }}
    hostPort: {{ machine_lima_http_host_port }}
    proto: tcp
    static: true
{% endif %}
{% if machine_lima_https_host_port | int > 0 %}
  - guestPort: {{ machine_lima_https_guest_port }}
    hostPort: {{ machine_lima_https_host_port }}
    proto: tcp
    static: true
{% endif %}
{% endif %}

{% if machine_lima_mount_home %}
mounts:
  - location: "~"
    writable: false
{% else %}
mounts: []
{% endif %}

containerd:
  system: false
  user: false

# Lima's normal guest user is used for SSH. System provisioning runs as root
# and ensures Ansible can manage packages and services without a password
# prompt.
provision:
  - mode: system
    script: |
      #!/bin/sh
      set -eu
      install -d -m 0750 /etc/sudoers.d
      printf '%%sudo ALL=(ALL:ALL) NOPASSWD: ALL\n' \
        > /etc/sudoers.d/90-imladris-lima
      chmod 0440 /etc/sudoers.d/90-imladris-lima
